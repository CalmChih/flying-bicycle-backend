<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.fallingintodreams.flying.bicycle.backend.dao.ITagsDao">
    <resultMap id="tagsMap" type="top.fallingintodreams.flying.bicycle.backend.po.Tags">
        <id column="id" property="id"/>
        <result column="tag_id" property="tagId"/>
        <result column="tag_name" property="tagName"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getTagList" parameterType="hashmap" resultMap="tagsMap">
        SELECT tag_id, tag_name FROM tags WHERE state = 1
        <if test="tagName != '' and tagName != null">
            AND tag_name LIKE CONCAT('%', #{tagName}, '%')
        </if>
    </select>

    <update id="deleteTag" parameterType="long">
        UPDATE tags
        SET state = 2
        WHERE tag_id = #{tagId}
    </update>

    <update id="updateTag">
        UPDATE tags
        SET tag_name = #{tagName}
        WHERE tag_id = #{tagId}
    </update>

    <insert id="insertTag" parameterType="top.fallingintodreams.flying.bicycle.backend.po.Tags">
        INSERT INTO tags (tag_id, tag_name, create_time, update_time)
        VALUES (#{tagId}, #{tagName}, NOW(), NOW())
    </insert>

</mapper>
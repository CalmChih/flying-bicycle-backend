<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.fallingintodreams.flying.bicycle.backend.dao.ICategorizationDao">
    <resultMap id="categoryMap" type="top.fallingintodreams.flying.bicycle.backend.po.Categorization">
        <id column="id" property="id"/>
        <result column="category_id" property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getCategoryList" resultMap="categoryMap">
        SELECT category_id, category_name FROM categorization WHERE state = 1
    </select>

</mapper>
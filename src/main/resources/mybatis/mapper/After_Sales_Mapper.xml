<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.fallingintodreams.flying.bicycle.backend.dao.IAfterSalesDao">
    <resultMap id="afterSalesMap" type="top.fallingintodreams.flying.bicycle.backend.po.AfterSales">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="username" property="username"/>
        <result column="goods_id" property="goodsId"/>
        <result column="goods_title" property="goodsTitle"/>
        <result column="total_price" property="totalPrice"/>
        <result column="request_refund_amount" property="requestRefundAmount"/>
        <result column="refund_reason" property="refundReason"/>
        <result column="actual_refund_amount" property="actualRefundAmount"/>
        <result column="seller_reply" property="sellerReply"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insertAfterSalesInfo" parameterType="top.fallingintodreams.flying.bicycle.backend.po.AfterSales">
        INSERT INTO after_sales (order_id, username, goods_id, goods_title, total_price, request_refund_amount,
                                 refund_reason, actual_refund_amount, seller_reply, state, create_time, update_time)
        VALUES (#{orderId}, #{username}, #{goodsId}, #{goodsTitle}, #{totalPrice}, #{requestRefundAmount},
                #{refundReason}, #{actualRefundAmount}, #{sellerReply}, #{state}, NOW(), NOW())
    </insert>

    <update id="updateAfterSalesInfo" parameterType="top.fallingintodreams.flying.bicycle.backend.po.AfterSales">
        UPDATE after_sales
        <set>
            <if test="actualRefundAmount != null">
                actual_refund_amount = #{actualRefundAmount}
            </if>
            <if test="sellerReply != null and sellerReply != ''">
                , seller_reply = #{sellerReply}
            </if>
        </set>
        WHERE order_id = #{orderId}
    </update>

    <select id="getAfterSalesList" resultMap="afterSalesMap">
        SELECT order_id,
        username,
        goods_id,
        goods_title,
        total_price,
        request_refund_amount,
        refund_reason,
        actual_refund_amount,
        seller_reply,
        state,
        create_time
        FROM after_sales
        <where>
            <if test="username != null and username != ''">
                username = #{username}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.fallingintodreams.flying.bicycle.backend.dao.IOrderDao">
    <resultMap id="orderMap" type="top.fallingintodreams.flying.bicycle.backend.po.Order">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="username" property="username"/>
        <result column="goods_id" property="goodsId"/>
        <result column="reservation_start_time" property="reservationStartTime"/>
        <result column="reservation_end_time" property="reservationEndTime"/>
        <result column="reservation_days" property="reservationDays"/>
        <result column="total_price" property="totalPrice"/>
        <result column="pay_time" property="payTime"/>
        <result column="order_state" property="orderState"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insertOrder" parameterType="top.fallingintodreams.flying.bicycle.backend.po.Order">
        INSERT INTO `order` (order_id, username, goods_id, reservation_start_time, reservation_end_time,
                             reservation_days, total_price, create_time,
                             update_time)
        VALUES (#{orderId}, #{username}, #{goodsId}, #{reservationStartTime}, #{reservationEndTime}, #{reservationDays},
                #{totalPrice}, NOW(), NOW())
    </insert>

    <update id="updateOrder" parameterType="top.fallingintodreams.flying.bicycle.backend.po.Order">
        UPDATE `order`
        <set>
            <if test="payTime != null">
                pay_time = #{payTime},
            </if>
            <if test="orderState != null">
                order_state = #{orderState}
            </if>
        </set>
        WHERE order_id = #{orderId}
    </update>

    <select id="getOrderList" parameterType="long" resultMap="orderMap">
        SELECT id,
               reservation_start_time,
               reservation_end_time,
               pay_time,
               order_state,
               create_time
        FROM `order`
        WHERE username = #{username}
    </select>

    <select id="getOrderInfo" parameterType="string"
            resultMap="orderMap">
        SELECT username,
               order_id,
               goods_id,
               reservation_start_time,
               reservation_end_time,
               reservation_days,
               total_price,
               pay_time,
               order_state,
               create_time
        FROM `order`
        WHERE order_id = #{orderId}
    </select>

    <select id="getReservationGoodsNum" parameterType="hashmap"
            resultType="top.fallingintodreams.flying.bicycle.backend.vo.ReservationGoodsVO">
        SELECT goods_id goodsId, COUNT(*) num
        FROM `order`
        WHERE reservation_start_time &lt;= #{reservationEndTime}
          AND reservation_end_time &gt;= #{reservationStartTime}
        GROUP BY goods_id
    </select>
</mapper>